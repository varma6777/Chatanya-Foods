{
  "buildCommand": "node -e \"const fs=require('fs'),cp=require('child_process');if(fs.existsSync('Frontend')){process.chdir('Frontend');cp.execSync('npm run build',{stdio:'inherit'});fs.cpSync('dist','../dist',{recursive:true})}else{cp.execSync('npm run build',{stdio:'inherit'})}\"",
  "outputDirectory": "dist",
  "framework": "vite"
}
